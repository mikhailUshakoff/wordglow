{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wordglow",
  "version": "0.1.0",
  "identifier": "dev.wordglow.app",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "trunk serve --config wordglow/Trunk.toml",
    "beforeBuildCommand": "trunk build --release --config wordglow/Trunk.toml"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wordglow",
        "width": 1000,
        "height": 700
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
